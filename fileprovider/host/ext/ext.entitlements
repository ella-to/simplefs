<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App extensions on macOS must be sandboxed. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- File Provider requires an App Group shared with the container app.
         Must match NSExtensionFileProviderDocumentGroup in Info.plist. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.to.ella.simplefs</string>
    </array>
</dict>
</plist>
