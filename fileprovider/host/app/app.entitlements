<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Must include the same App Group as the extension so the system can
         pair them; this is what fixes File Provider error -2001. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.to.ella.simplefs</string>
    </array>
</dict>
</plist>
